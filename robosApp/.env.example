# Plantilla de variables para docker-compose.yml (opción B de DESPLIEGUE.md).
# Copiar a ".env" en el servidor y completar. El .env NO se sube a GitHub (está en .gitignore).

DB_USERNAME=robosapp
DB_PASSWORD=cambiar-por-una-contraseña-larga
DB_ROOT_PASSWORD=cambiar-por-otra-contraseña-larga

# Contenido completo del .json de la clave de servicio de Firebase, en una sola línea y entre comillas simples
ROBOSAPP_FIREBASE_CREDENCIALES_JSON='{"type":"service_account", ...}'
