# Copiar este archivo como .env.local y completar. .env.local está en .gitignore.

# Dirección del backend. Normalmente NO hace falta: la app la detecta sola (usa la IP de la PC que corre Expo).
# Descomentar y completar solo si se usa "expo start --tunnel" o si el backend corre en otro equipo.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Token de prueba del backend (dev-cliente, dev-cliente-2, dev-cliente-3 o dev-admin).
# Solo se usa si Firebase NO está configurado (abajo). Con Firebase, la app pide entrar con mail y contraseña.
EXPO_PUBLIC_DEV_TOKEN=dev-cliente-2

# Login con Firebase: la configuración de la app web del proyecto de Firebase
# (consola de Firebase → Configuración del proyecto → Tus apps → la app web).
# No son secretos: Firebase los pone dentro de la app a propósito. Sin ellos, se entra con los usuarios de prueba.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
# EXPO_PUBLIC_FIREBASE_APP_ID=
